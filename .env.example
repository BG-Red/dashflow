# ─── Copy to .env for local dev. NEVER commit real values. ───────────────────────
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# web | worker | all
APP_ROLE=all

# Postgres (Azure: use Entra auth via managed identity, see docs/deploy.md)
DATABASE_URL=postgres://avd:avd@localhost:5432/avd

# easyauth (Azure Container Apps) | dev (local only, refuses to run in production)
AUTH_MODE=dev
# Dev auth refuses any HOST but localhost unless you set this (containers need 0.0.0.0).
DEV_AUTH_ALLOW_REMOTE=false
DEV_USER_EMAIL=dev.user@contoso.onmicrosoft.com
DEV_USER_OID=00000000-0000-0000-0000-000000000001
DEV_USER_TID=00000000-0000-0000-0000-000000000002

# Comma-separated home tenant IDs allowed to sign in (empty = any tenant EasyAuth lets through)
ALLOWED_TENANT_IDS=
# Verify X-MS-TOKEN-AAD-ID-TOKEN signature against Entra JWKS (requires token store)
EASYAUTH_VALIDATE_TOKEN=false
EASYAUTH_CLIENT_ID=
# Comma-separated Entra object IDs that become Owner without the setup code
BOOTSTRAP_OWNER_OIDS=

# 32-byte base64 key for encrypting secrets stored in Postgres: `openssl rand -base64 32`
APP_ENCRYPTION_KEY=
# Optional: Key Vault used for secret references (https://<name>.vault.azure.net)
KEY_VAULT_URI=
# Client ID of the user-assigned managed identity (Azure only)
AZURE_CLIENT_ID=

# Public base URL, used for OAuth redirect (Partner Center consent)
PUBLIC_BASE_URL=http://localhost:3000

# Load synthetic data and allow demo tenants
DEMO_MODE=true
LOG_LEVEL=info
