{
  "name": "avd-dashboards",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@avd/server' dev & bun run --filter '@avd/web' dev",
    "build": "bun run --filter '@avd/web' build",
    "start": "bun apps/server/src/index.ts",
    "db:generate": "bun run --filter '@avd/db' generate",
    "db:migrate": "bun packages/db/src/migrate.ts",
    "demo:seed": "bun packages/demo/src/seed.ts",
    "test": "bun test",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome format --write .",
    "secrets:scan": "gitleaks detect --config .gitleaks.toml --redact -v",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "lefthook": "2.1.14",
    "typescript": "5.9.3"
  }
}
