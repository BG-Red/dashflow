      "type": "string",
      "metadata": {
        "description": "Entra app registration (client) ID used by Container Apps authentication."
      }
    },
    "authClientSecret": {
      "type": "securestring",
      "metadata": {
        "description": "Client secret for that app registration. Stored in Key Vault, never in outputs."
